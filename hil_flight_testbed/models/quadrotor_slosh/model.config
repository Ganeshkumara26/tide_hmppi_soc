<?xml version="1.0" ?>
<model>
  <name>quadrotor_slosh</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>
  <author>
    <name>HIL Flight Testbed Team</name>
    <email>hil-dev@testbed.internal</email>
  </author>
  <description>
    Heavy-lift 6-DoF quadrotor UAV carrying a 35L liquid payload tank modeled as an equivalent
    spherical pendulum (L_p = 0.18 m, omega_n = 7.38 rad/s, zeta = 0.05) with active time-varying
    mass depletion (spray rate q = 1.5 - 4.0 L/min). Integrated with Pixhawk 6C PX4 HIL and
    SCL 0.8um Gate-Level Netlist Bridge.
  </description>
</model>
