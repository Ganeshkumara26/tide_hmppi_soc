<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="hil_flight_field">
    <!-- Ambient illumination & Sun -->
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Physics Solver Configuration (100 Hz outer loop, 400 Hz inner physics) -->
    <physics type="ode">
      <max_step_size>0.0025</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>400</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>20</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- Cylindrical Obstacles for Act 1 Obstacle Avoidance Trajectory -->
    <!-- Obstacle 1: (x=10.0, y=0.5, r=1.5, h=12.0) -->
    <model name="cylinder_obs_1">
      <static>true</static>
      <pose>10.0 0.5 6.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder><radius>1.5</radius><length>12.0</length></cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder><radius>1.5</radius><length>12.0</length></cylinder>
          </geometry>
          <material><ambient>0.8 0.2 0.2 1.0</ambient></material>
        </visual>
      </link>
    </model>

    <!-- Obstacle 2: (x=22.0, y=-1.5, r=1.8, h=12.0) -->
    <model name="cylinder_obs_2">
      <static>true</static>
      <pose>22.0 -1.5 6.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder><radius>1.8</radius><length>12.0</length></cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder><radius>1.8</radius><length>12.0</length></cylinder>
          </geometry>
          <material><ambient>0.8 0.4 0.1 1.0</ambient></material>
        </visual>
      </link>
    </model>

    <!-- Obstacle 3: (x=35.0, y=1.0, r=1.5, h=12.0) -->
    <model name="cylinder_obs_3">
      <static>true</static>
      <pose>35.0 1.0 6.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder><radius>1.5</radius><length>12.0</length></cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder><radius>1.5</radius><length>12.0</length></cylinder>
          </geometry>
          <material><ambient>0.8 0.2 0.2 1.0</ambient></material>
        </visual>
      </link>
    </model>

    <!-- Obstacle 4: (x=48.0, y=-0.5, r=1.6, h=12.0) -->
    <model name="cylinder_obs_4">
      <static>true</static>
      <pose>48.0 -0.5 6.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder><radius>1.6</radius><length>12.0</length></cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder><radius>1.6</radius><length>12.0</length></cylinder>
          </geometry>
          <material><ambient>0.8 0.5 0.2 1.0</ambient></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
